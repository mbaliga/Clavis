<?xml version="1.0" encoding="utf-8"?>
<!-- LARGE (about 4x3) card template: adds body, three detail lines, a footer and a second button. Title to detail lines give way first when space runs short; the footer and buttons keep their height. Bound by WidgetViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="12dp"
    android:orientation="vertical"
    tools:targetApi="31">
    <TextView
        android:id="@+id/widget_label"
        style="@style/Widget.Clavis.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            style="@style/Widget.Clavis.TitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_body"
            style="@style/Widget.Clavis.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_meta"
            style="@style/Widget.Clavis.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_line1"
            style="@style/Widget.Clavis.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_line2"
            style="@style/Widget.Clavis.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_line3"
            style="@style/Widget.Clavis.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_footer"
        style="@style/Widget.Clavis.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="end"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_secondary"
            style="@style/Widget.Clavis.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_primary"
            style="@style/Widget.Clavis.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
