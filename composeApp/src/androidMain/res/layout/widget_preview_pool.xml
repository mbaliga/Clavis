<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview (sample content) for The pool widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:orientation="vertical"
    tools:targetApi="31">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/widget_headline_sample"
            style="@style/Widget.Clavis.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/widget_preview_pool_headline" />
        <TextView
            style="@style/Widget.Clavis.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/widget_headline_sample"
            android:layout_centerVertical="true"
            android:text="@string/widget_pool_name" />
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/widget_sample_row1_swatch"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="#FFB3543B" />
            <TextView
                android:id="@+id/widget_sample_row1_end"
                style="@style/Widget.Clavis.Row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_ready_3" />
            <TextView
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/widget_sample_row1_swatch"
                android:layout_toStartOf="@id/widget_sample_row1_end"
                android:layout_alignWithParentIfMissing="true"
                android:layout_centerVertical="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_lang_es" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/widget_sample_row2_swatch"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="#FF7A5CC0" />
            <TextView
                android:id="@+id/widget_sample_row2_end"
                style="@style/Widget.Clavis.Row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_ready_1" />
            <TextView
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/widget_sample_row2_swatch"
                android:layout_toStartOf="@id/widget_sample_row2_end"
                android:layout_alignWithParentIfMissing="true"
                android:layout_centerVertical="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_lang_fr" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/widget_sample_row3_swatch"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="#FF4E6B8A" />
            <TextView
                android:id="@+id/widget_sample_row3_end"
                style="@style/Widget.Clavis.Row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_still" />
            <TextView
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/widget_sample_row3_swatch"
                android:layout_toStartOf="@id/widget_sample_row3_end"
                android:layout_alignWithParentIfMissing="true"
                android:layout_centerVertical="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_lang_de" />
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_footer"
        style="@style/Widget.Clavis.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
