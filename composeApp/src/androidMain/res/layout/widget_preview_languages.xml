<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview (sample content) for the Your languages widget. -->
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="4dp"
    android:columnCount="2"
    android:useDefaultMargins="false"
    tools:targetApi="31">
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="2dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_pad"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/widget_pad1_sample_swatch"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="#FFB3543B" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_pad1_sample_swatch"
            android:layout_alignWithParentIfMissing="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_lang_es" />
            <TextView
                style="@style/Widget.Clavis.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_ready_3" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="2dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_pad"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/widget_pad2_sample_swatch"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="#FF7A5CC0" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_pad2_sample_swatch"
            android:layout_alignWithParentIfMissing="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_lang_fr" />
            <TextView
                style="@style/Widget.Clavis.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_ready_1" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="2dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_pad"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/widget_pad3_sample_swatch"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="#FF3E8D5C" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_pad3_sample_swatch"
            android:layout_alignWithParentIfMissing="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_lang_it" />
            <TextView
                style="@style/Widget.Clavis.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_still" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="2dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_pad"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/widget_pad4_sample_swatch"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="#FF4E6B8A" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_pad4_sample_swatch"
            android:layout_alignWithParentIfMissing="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_lang_de" />
            <TextView
                style="@style/Widget.Clavis.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_still" />
        </LinearLayout>
    </RelativeLayout>
</GridLayout>
