<?xml version="1.0" encoding="utf-8"?>
<!-- LARGE (about 4x3) pads template: six lane shortcuts, each at least 48dp tall from 164dp (WidgetSize.LARGE starts at 240). Bound by WidgetViews. -->
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="4dp"
    android:columnCount="2"
    android:useDefaultMargins="false"
    tools:targetApi="31">
    <RelativeLayout
        android:id="@+id/widget_pad1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="2dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_pad"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/widget_pad1_swatch"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_pad1_swatch"
            android:layout_alignWithParentIfMissing="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_pad1_title"
                style="@style/Widget.Clavis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_pad1_sub"
                style="@style/Widget.Clavis.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
