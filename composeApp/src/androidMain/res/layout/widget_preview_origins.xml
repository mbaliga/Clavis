<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview (sample content) for the Word origins widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="12dp"
    android:orientation="vertical"
    tools:targetApi="31">
    <TextView
        style="@style/Widget.Clavis.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_origin_label" />
    <TextView
        style="@style/Widget.Clavis.Title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:maxLines="3"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="20sp"
        android:text="@string/widget_preview_origin_title" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/widget_primary_sample"
            style="@style/Widget.Clavis.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_see_web" />
        <TextView
            style="@style/Widget.Clavis.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/widget_primary_sample"
            android:layout_centerVertical="true"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/widget_preview_origin_meta" />
    </RelativeLayout>
</LinearLayout>
