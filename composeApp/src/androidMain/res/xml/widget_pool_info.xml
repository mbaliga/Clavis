<?xml version="1.0" encoding="utf-8"?>
<!-- The pool: due or still, per language (stat and list templates). Resizable from 2x1 up; docs/widgets.md lists what each size adds.
     updatePeriodMillis is 0: the app pushes updates when it leaves the foreground and one inexact
     alarm redraws at the next moment a card falls due (ClavisWidgets). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_pool_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_list"
    android:previewLayout="@layout/widget_preview_pool"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
