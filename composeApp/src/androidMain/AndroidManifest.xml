<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Offline-first (D-13). INTERNET is used by exactly one path: a recording (Commons / Tatoeba)
         the learner explicitly taps to download; nothing else in the app opens a socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility for the system text-to-speech engines (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ClavisApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clavis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Freeform / desktop-mode windows only; phones and fullscreen are unaffected. The floor matches the
                 desktop build's 480 x 720 dp minimum (OD-12), the size the compact layout is verified at. -->
            <layout
                android:defaultWidth="1100dp"
                android:defaultHeight="780dp"
                android:minWidth="480dp"
                android:minHeight="720dp" />
        </activity>
    </application>

</manifest>
